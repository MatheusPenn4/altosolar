# ── Landing page (já existentes) ──────────────────────────────────────────
# A1 — IDs de tracking (deixe vazio para desativar)
# Google Analytics 4 (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta Pixel (ID numérico do Gerenciador de Eventos)
NEXT_PUBLIC_META_PIXEL_ID=

# ── Painel administrativo ──────────────────────────────────────────────────
# Públicas (expostas ao navegador — OK, são chaves com RLS aplicado):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Exclusivamente server-side — NUNCA prefixar com NEXT_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Opcional: várias chaves separadas por vírgula (ex.: de contas Google gratuitas
# diferentes) — quando uma esgota a cota diária, a próxima é usada automaticamente.
# Se definida, tem prioridade sobre GEMINI_API_KEY.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash

# Segredo compartilhado entre a rota /api/propostas/[id]/gerar-pdf (Next.js) e a
# função Python /api/gerar-proposta-pdf.py que renderiza o PDF da proposta.
# Gere um valor aleatório (ex.: `openssl rand -hex 32`) e use o MESMO valor nas
# duas variáveis de ambiente da Vercel — a função Python roda fora do
# middleware/sessão do Supabase, então esse segredo é a única proteção dela.
PROPOSAL_PDF_INTERNAL_SECRET=
